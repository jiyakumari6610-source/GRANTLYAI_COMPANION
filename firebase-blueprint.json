{
  "entities": {
    "Profile": {
      "title": "Student Profile",
      "description": "Structured Indian student academic, personal, and socio-economic profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 20 },
        "state": { "type": "string", "maxLength": 80 },
        "district": { "type": "string", "maxLength": 80 },
        "dateOfBirth": { "type": "string", "maxLength": 20 },
        "gender": { "type": "string", "enum": ["Female", "Male", "Non-Binary", "Prefer not to say"] },
        "category": { "type": "string", "enum": ["General", "OBC-NCL", "SC", "ST", "EWS", "Minority"] },
        "disabilityStatus": { "type": "string", "enum": ["None", "PwD (40% or above)", "PwD (Below 40%)"] },
        "disabilityDetails": { "type": "string", "maxLength": 240 },
        "educationLevel": { "type": "string", "enum": ["Class 11-12", "Diploma / Polytechnic", "Undergraduate (UG)", "Postgraduate (PG)", "PhD / Doctoral"] },
        "courseSpecialization": { "type": "string", "maxLength": 160 },
        "institutionName": { "type": "string", "maxLength": 200 },
        "collegeLocation": { "type": "string", "maxLength": 160 },
        "academicYear": { "type": "string", "maxLength": 30 },
        "currentSemesterOrYear": { "type": "string", "maxLength": 40 },
        "previousMarksPercent": { "type": "number" },
        "familyAnnualIncomeInr": { "type": "number" },
        "parentOccupation": { "type": "string", "maxLength": 160 },
        "hostelStatus": { "type": "string", "enum": ["Hosteller", "Day Scholar"] },
        "certificates": { "type": "array", "maxLength": 20 },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "onboardingCompleted", "createdAt", "updatedAt"]
    },
    "UserRole": {
      "title": "User Role",
      "description": "Server and Super Admin-managed role-based access control entry.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "enum": ["student", "admin", "super_admin", "reviewer"] },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "assignedBy": { "type": "string", "maxLength": 128 },
        "assignedByEmail": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "createdAt", "updatedAt"]
    },
    "Scholarship": {
      "title": "Scholarship",
      "description": "Verified Indian scholarship program with source attribution, provenance, cycle status, and eligibility metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 2, "maxLength": 240 },
        "provider": { "type": "string", "minLength": 2, "maxLength": 200 },
        "scholarshipType": {
          "type": "string",
          "enum": [
            "Central Government",
            "State Government",
            "Private",
            "Corporate",
            "University",
            "Merit-Based",
            "Need-Based",
            "Category-Based",
            "Private Foundation"
          ]
        },
        "description": { "type": "string", "maxLength": 2000 },
        "benefitsSummary": { "type": "string", "maxLength": 800 },
        "financialBenefitsText": { "type": "string", "maxLength": 800 },
        "annualAwardInr": { "type": "number" },
        "eligibilitySummary": { "type": "string", "maxLength": 1500 },
        "academicRequirements": { "type": "string", "maxLength": 600 },
        "minIncomeLimitInr": { "type": "number" },
        "incomeLimitInr": { "type": "number" },
        "educationLevels": { "type": "array" },
        "eligibleCourses": { "type": "array" },
        "allowedCategories": { "type": "array" },
        "eligibleStates": { "type": "array" },
        "minMarksPercent": { "type": "number" },
        "genderRestriction": { "type": "string", "enum": ["All", "Female", "Male"] },
        "disabilityRequired": { "type": "boolean" },
        "requiredDocuments": { "type": "array" },
        "applicationStartDate": { "type": "string", "maxLength": 60 },
        "applicationDeadline": { "type": "string", "maxLength": 60 },
        "applicationProcess": { "type": "string", "maxLength": 1500 },
        "applicationStatus": {
          "type": "string",
          "enum": ["Currently accepting applications", "Upcoming", "Closed", "Expired", "Status unknown"]
        },
        "deadlineStatus": { "type": "string", "maxLength": 60 },
        "officialUrl": { "type": "string", "maxLength": 500 },
        "officialSourceUrl": { "type": "string", "maxLength": 500 },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "Unverified",
            "Pending Review",
            "Verified",
            "Needs Correction",
            "Expired",
            "Archived",
            "Pending verification",
            "Needs verification",
            "Verified Official Source"
          ]
        },
        "lastVerifiedDate": { "type": "string", "maxLength": 40 },
        "sourceNotes": { "type": "string", "maxLength": 600 },
        "sourceName": { "type": "string", "maxLength": 200 },
        "retrievedAt": { "type": "string", "maxLength": 40 },
        "verifiedByUid": { "type": "string", "maxLength": 128 },
        "verifiedByEmail": { "type": "string", "maxLength": 200 },
        "verificationNotes": { "type": "string", "maxLength": 1000 },
        "sourceEvidence": { "type": "string", "maxLength": 1500 },
        "isActive": { "type": "boolean" },
        "archivedAt": { "type": "string", "maxLength": 40 },
        "archivedByUid": { "type": "string", "maxLength": 128 },
        "activeRuleVersion": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "provider", "scholarshipType", "officialUrl", "verificationStatus", "createdAt", "updatedAt"]
    },
    "ScholarshipEligibilityRule": {
      "title": "Scholarship Eligibility Rule",
      "description": "Granular structured eligibility rule linked to a scholarship.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scholarshipId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ruleKey": { "type": "string", "maxLength": 80 },
        "ruleLabel": { "type": "string", "maxLength": 200 },
        "operator": { "type": "string", "enum": ["lte", "gte", "in", "eq", "neq", "contains"] },
        "ruleValue": { "type": "string", "maxLength": 300 },
        "isMandatory": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "versionNumber": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "scholarshipId", "ruleKey", "ruleLabel", "operator", "ruleValue", "isMandatory", "createdAt"]
    },
    "Application": {
      "title": "Scholarship Application",
      "description": "Student-tracked scholarship application lifecycle record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scholarshipId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scholarshipTitle": { "type": "string", "maxLength": 240 },
        "provider": { "type": "string", "maxLength": 200 },
        "status": {
          "type": "string",
          "enum": [
            "Interested",
            "Preparing",
            "Documents Pending",
            "Ready to Apply",
            "Submitted",
            "Under Review",
            "Correction Required",
            "Approved",
            "Rejected",
            "Withdrawn",
            "Closed",
            "Draft",
            "Documents Ready",
            "Awarded"
          ]
        },
        "portalReferenceId": { "type": "string", "maxLength": 120 },
        "deadline": { "type": "string", "maxLength": 60 },
        "notes": { "type": "string", "maxLength": 2000 },
        "submissionDate": { "type": "string", "maxLength": 40 },
        "submissionConfirmedByStudent": { "type": "boolean" },
        "submissionConfirmedAt": { "type": "string", "format": "date-time" },
        "portalOpenedAt": { "type": "string", "format": "date-time" },
        "finalOutcome": { "type": "string", "maxLength": 300 },
        "correctionNotes": { "type": "string", "maxLength": 1000 },
        "lastStatusChangedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "scholarshipId", "scholarshipTitle", "status", "createdAt", "updatedAt"]
    },
    "ApplicationEvent": {
      "title": "Application Timeline Event",
      "description": "Chronological audit event for a tracked scholarship application.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "applicationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scholarshipId": { "type": "string", "minLength": 1, "maxLength": 128 },
